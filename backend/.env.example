PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cryptella
JWT_SECRET=f74e15457924212a6769e1f21447ea9b43a7b24aa2a55b6bee6c01ef74ac5a1dbca19246065c0f265d62c56cbbc3803b
JWT_EXPIRES_IN=7d
NODE_ENV=development

# CoinGecko live prices. Works without a key (public API, refresh every 60s).
# A free Demo key (https://www.coingecko.com/en/api) is recommended; plan: demo | pro
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo
# Optional. Defaults: public 60s, demo 300s, pro 30s (lower values are clamped to stay under quota)
COINGECKO_REFRESH_SECONDS=

# Admin account (created on startup if missing; password must be 12+ characters)
ADMIN_EMAIL=admin@cryptella.com
ADMIN_PASSWORD=HdOQz_j9ekZqSSUb

# Buy orders (naira)
MIN_ORDER_NGN=5000
MAX_ORDER_NGN=4500000
PAYMENT_WINDOW_MINUTES=30
MAX_OPEN_UNPAID_ORDERS=3
# Naira rate: leave NGN_PER_USD empty to use the live market rate (+ optional markup %)
NGN_PER_USD=
NGN_RATE_MARKUP_PERCENT=0

# Naira collection accounts customers pay into (JSON array, round-robin).
# Required in production. Example:
# PAYMENT_ACCOUNTS=[{"bankName":"Moniepoint MFB","accountNumber":"1234567890","accountName":"Cryptella Ltd"}]
PAYMENT_PROVIDER=manual
PAYMENT_ACCOUNTS=
