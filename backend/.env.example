COINGECKO_API_PLAN=demo
# Optional. Defaults: public 60s, demo 300s, pro 30s (lower values are clamped to stay under quota)
COINGECKO_REFRESH_SECONDS=

# Admin account (created on startup if missing; password must be 12+ characters)
ADMIN_EMAIL=admin@cryptella.com
ADMIN_PASSWORD=l_QPWVXTkz8GkmsWtL4M

# Buy orders (naira)
MIN_ORDER_NGN=5000
MAX_ORDER_NGN=4500000
PAYMENT_WINDOW_MINUTES=30
MAX_OPEN_UNPAID_ORDERS=3
# Minutes a seller has to send the crypto and submit the transaction hash
SELL_DEPOSIT_WINDOW_MINUTES=60

# Naira collection accounts customers pay into (JSON array, round-robin).
# Required in production. Example:
# PAYMENT_ACCOUNTS=[{"bankName":"Moniepoint MFB","accountNumber":"1234567890","accountName":"Cryptella Ltd"}]
PAYMENT_PROVIDER=manual
PAYMENT_ACCOUNTS=

# Naira pricing from USDT/NGN P2P prices
# Buy rate = P2P buy price + charge (per $1)
BUY_CHARGE_NGN_PER_USD=20
# Minimum purchase (USD), and fee by purchase amount as from:fee pairs (USD), deducted from the purchase
BUY_MIN_USD=5
BUY_FEE_TIERS=0:0.5,100:1,200:2,300:3,500:4,1000:5
# Sell rate = P2P sell price - charge (per $1)
SELL_CHARGE_NGN_PER_USD=20
# Price sources tried in order: binance + bybit (P2P adverts), quidax (NG exchange, fallback); refresh interval; max age before orders pause
P2P_SOURCES=bybit
P2P_REFRESH_SECONDS=120
P2P_MAX_AGE_MINUTES=15
